        "driverReserveGiB": 0
      },
      "floors": { "4": 128, "8": 69 },
      "expected": {
        "kind": "discrete",
        "type": "gpu",
        "unit": "GB",
        "recommended": 512,
        "layouts": [
          { "gpuCount": 4, "vramPerGpu": 128 },
          { "gpuCount": 8, "vramPerGpu": 69 }
        ]
      }
    }
  ],
